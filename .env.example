# Database
# For production (Neon free tier), append connection pool params:
DATABASE_URL=postgresql://user:password@host:5432/dbname?connection_limit=5&pool_timeout=10
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Super Admin Credentials (for initial seed)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_this_password
SUPER_ADMIN_NAME=Super Admin

# JWT
# Use a strong random value (32+ chars)
JWT_SECRET=replace_with_a_strong_random_secret_32_chars_minimum
# Alternate env names also accepted by the API:
# JWT_SECRET_KEY=replace_with_a_strong_random_secret_32_chars_minimum
# AUTH_JWT_SECRET=replace_with_a_strong_random_secret_32_chars_minimum
# AUTH_SECRET=replace_with_a_strong_random_secret_32_chars_minimum
# Note: token expiry is hardcoded to 7d in apps/api/src/utils/jwt.ts (no env override).

# OAuth - Google (optional - get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth - GitHub (optional - get from https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Cloudinary (Image hosting - get from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo Email Service (get from https://app.brevo.com/settings/keys/api)
# Used for: welcome emails, event notifications, announcement notifications
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Club Name

# Node Environment
NODE_ENV=development
ENABLE_DEV_AUTH=false
PORT=5001
INVITE_LINK_WH=whatsapp_invite_link

# Render free tier memory tuning
# Set NODE_OPTIONS=--max-old-space-size=400 in Render dashboard environment variables

# Database connection pool (Neon free tier: max ~10 connections)
# Append ?connection_limit=5&pool_timeout=10 to DATABASE_URL for production

# Optional — attendance signing (legacy fallback, see apps/api/src/routes/settings.ts)
# Unset uses the DB-backed setting.
# ATTENDANCE_JWT_SECRET=

# Optional — IndexNow search indexing (see apps/api/src/utils/indexnow.ts, routes/sitemap.ts)
# Unset skips IndexNow submissions.
# INDEXNOW_KEY=

# Optional — code execution proxy (see apps/api/src/utils/codeJudge.ts)
# Unset uses the built-in Cloudflare Worker URL; secret unset keeps legacy mode.
# EXECUTOR_URL=
# EXECUTOR_SECRET=

# Optional — contest relay/offload to playground execute-server (see apps/api/src/utils/internalApi.ts)
# Unset disables the relay (clients poll, plagiarism runs inline).
# INTERNAL_API_SECRET auto-derives from JWT_SECRET when unset — set explicitly on
# both services only to override the derived value.
# PLAYGROUND_API_URL=
# INTERNAL_API_SECRET=

# Optional — code execution provider override (see apps/api/src/utils/executionRouting.ts)
# Admin DB setting wins when set; unset uses the default provider.
# CODE_EXECUTION_PROVIDER=

# Optional — runtime toggles (see apps/api/src/index.ts)
# ENABLE_BACKGROUND_SCHEDULERS defaults ON in production / OFF in development.
# ENABLE_DB_KEEPALIVE defaults OFF (set to "true" to enable).
# ENABLE_REQUEST_LOGGING defaults ON in development only (set to "true" to force on).
# ENABLE_BACKGROUND_SCHEDULERS=
# ENABLE_DB_KEEPALIVE=
# ENABLE_REQUEST_LOGGING=

# Optional — AuditLog auto-pruning (see apps/api/src/utils/scheduler.ts)
# Unset keeps AuditLog rows forever; when set must be an integer >= 30.
# AUDIT_LOG_RETENTION_DAYS=

# Optional — public API base URL for certificate links (see apps/api/src/utils/publicUrl.ts)
# Explicit API_BASE_URL or PUBLIC_API_BASE_URL wins (ensures /api suffix); else
# RENDER_EXTERNAL_URL; else non-production falls back to http://localhost:<PORT>/api.
# Unset in production throws when building certificate download URLs.
# API_BASE_URL=
# PUBLIC_API_BASE_URL=
# RENDER_EXTERNAL_URL=

# Optional — Socket.io WebSocket engine (see apps/api/src/utils/socket.ts)
# Unset tries the eiows C++ engine (default) with a LOUD fallback to stock `ws`.
# WS_ENGINE=ws forces stock `ws` (instant, no-code rollback).
# WS_ENGINE_STRICT=true refuses to boot when eiows is unavailable (fail the deploy,
# not production); ignored when WS_ENGINE=ws. Unset/false falls back to `ws`.
# WS_ENGINE=
# WS_ENGINE_STRICT=

# Optional — TEMPORARY prod diagnostics for IP resolution (see apps/api/src/index.ts)
# Unset/off by default. LOG_IP_DIAGNOSTICS=true logs req.ip vs cf-connecting-ip vs
# XFF per request for the ~24h S2 readback (docs/deep-audit/ops-checklist.md) — then unset.
# LOG_IP_DIAGNOSTICS=

# Optional — per-connection Postgres statement_timeout (see apps/api/src/lib/prisma.ts)
# Unset/empty/0/invalid = disabled (default OFF). Opt-in (~8000) only AFTER verifying
# Neon's pooled endpoint (PgBouncer) honors the libpq startup option — it may honor,
# silently strip, or REJECT it (rejection refuses every pooled connection). Fires as
# PG 57014 and is deliberately NOT retried. Rollback = unset/0 + restart.
# PG_STATEMENT_TIMEOUT_MS=

# Optional — QuizAnswer retention (see apps/api/src/utils/scheduler.ts)
# Unset (default OFF) keeps QuizAnswer rows; QuizParticipant leaderboard aggregates
# are NEVER pruned. PRUNE_QUIZ_ANSWERS=true includes QuizAnswer > 365d in the sweep.
# PRUNE_QUIZ_ANSWERS=

# Optional — email reply-to identity (see apps/api/src/utils/emailTransport.ts)
# Unset defaults to tech_admin@codescriet.dev (name 'code.scriet Support').
# EMAIL_REPLY_TO=

# Optional — DB keep-alive interval in ms (see apps/api/src/index.ts)
# Unset defaults to 240000 (4 min). Applies only when ENABLE_DB_KEEPALIVE=true
# (itself default OFF).
# DB_KEEPALIVE_INTERVAL_MS=
