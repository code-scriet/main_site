# OPPE configuration — copy to .env.local and adjust ports as needed.
#
# All three are ORIGINS (no trailing /api — the client appends paths itself;
# a trailing /api is tolerated and stripped).
#
# VITE_OPPE_API_URL  — main club API. Only probed for an existing login
#                       session (header chip). Practice never needs it.
#                       Default when unset: https://api.codescriet.dev
# VITE_OPPE_EXEC_URL — club execution service (playground execute-server,
#                       CodeBox-backed). Java/C/C++/JS practice runs go here,
#                       anonymous quota, no login needed.
#                       Default when unset: http://localhost:5002 (dev) /
#                       https://playground-api.codescriet.dev (prod)
# VITE_OPPE_WEB_URL  — main site, where Sign in / Register live.
#                       Default when unset: http://localhost:5173 (dev) /
#                       https://codescriet.dev (prod)
VITE_OPPE_API_URL=http://localhost:5001
VITE_OPPE_EXEC_URL=http://localhost:5002
VITE_OPPE_WEB_URL=http://localhost:5173
