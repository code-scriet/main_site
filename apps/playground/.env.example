# Playground Configuration
VITE_API_URL=http://localhost:5002

# Optional — main API / site origins for shared auth and sign-in redirects
# (see apps/playground/src/lib/utils.ts, components/playground/Navbar.tsx).
# Unset falls back to the canonical domains (localhost in dev).
# VITE_MAIN_API_URL=http://localhost:5001
# VITE_MAIN_SITE_URL=http://localhost:5173

# Execution Server
PORT=5002
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174

# JWT Secret — must match the main API server's JWT_SECRET for shared auth
JWT_SECRET=

# Required in production (render.yaml) — same DATABASE_URL as the main API service.
# Unset falls back to in-memory storage (snippets/history not persisted).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — internal server-to-server secret for the contest relay + plagiarism
# offload. Auto-derives from JWT_SECRET when unset (must match on both services);
# set explicitly on both services only to override the derived value.
# INTERNAL_API_SECRET=

# Optional — daily execution limit (default 100 when unset).
# PLAYGROUND_DAILY_LIMIT=100

# Code execution proxy (Cloudflare Worker)
EXECUTOR_URL=https://codescriet-executor.developer-aary.workers.dev/execute
# Shared secret with the Worker. Set the SAME random value here AND in the
# Worker's environment (Cloudflare dashboard) so the Worker rejects anyone else.
# Leave blank to keep the Worker in legacy Origin-only mode during migration.
EXECUTOR_SECRET=

# Piston API (primary — free, no key needed)
PISTON_API_URL=https://emkc.org/api/v2/piston

# Judge0 API (fallback — requires RapidAPI key)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# Optional — canonical public playground origin (declared in src/vite-env.d.ts)
# Unset falls back to http://localhost:5174 in dev / https://code.codescriet.dev in prod.
# VITE_PLAYGROUND_URL=
